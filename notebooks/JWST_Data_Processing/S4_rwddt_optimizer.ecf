# =====================================================================
# Eureka! Control File - SHARED OPTIMIZER TEMPLATE (rwddt_optimizer)
# ---------------------------------------------------------------------
# DO NOT EDIT THIS FILE PER-TARGET.
#
# This is a shared, git-tracked ECF used internally by the Stage 1/3/4
# optimizers in DeepDive_Template.ipynb. It exists under the generic
# eventlabel 'rwddt_optimizer' (distinct from any real target eventlabel)
# so the optimizers can construct their internal Stage 1/2/3/4 Meta
# objects without needing this target's real per-stage ECF files to
# exist yet.
#
# The topdir/inputdir/outputdir values below are INERT PLACEHOLDERS:
# they are always overwritten at runtime by the optimizer's
# initialize_meta() before any file I/O happens against them.
#
# To tune settings for your target, edit the per-target ECF cells in
# the notebook (Section 3.2), NOT this file.
# =====================================================================

# Eureka! Control File for Stage 4: Generate Lightcurves

# Stage 4 Documentation: https://eurekadocs.readthedocs.io/en/latest/ecf.html#stage-4

# Number of spectroscopic channels spread evenly over given wavelength range
nspecchan       1
compute_white   False

allapers        True    # Run S4 on all of the apertures considered in S3? Otherwise will use newest output in the inputdir

# Parameters for sigma clipping
clip_binned     True    # Whether or not sigma clipping should be performed on the binned 1D time series
sigma           4.5     # The number of sigmas a point must be from the rolling median to be considered an outlier
box_width       31      # The width of the box-car filter (used to calculated the rolling median) in units of number of data points
maxiters        20      # The number of iterations of sigma clipping that should be performed.
boundary        fill    # Use 'fill' to extend the boundary values by the median of all data points (recommended), 'wrap' to use a periodic boundary, or 'extend' to use the first/last data points
fill_value      mask    # Either the string 'mask' to mask the outlier values (recommended), 'boxcar' to replace data with the mean from the box-car filter, or a constant float-type fill value.

# Diagnostics
hide_plots      True
verbose         False

# Project directory (placeholder - overwritten at runtime by initialize_meta)
topdir          /tmp

# Directories relative to topdir (placeholders - overwritten at runtime)
inputdir        Stage3
outputdir       Stage4
