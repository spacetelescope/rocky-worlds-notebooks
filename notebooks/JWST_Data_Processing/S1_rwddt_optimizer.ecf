# =====================================================================
# Eureka! Control File - SHARED OPTIMIZER TEMPLATE (rwddt_optimizer)
# ---------------------------------------------------------------------
# DO NOT EDIT THIS FILE PER-TARGET.
#
# This is a shared, git-tracked ECF used internally by the Stage 1/3/4
# optimizers in DeepDive_Template.ipynb. It exists under the generic
# eventlabel 'rwddt_optimizer' (distinct from any real target eventlabel)
# so the optimizers can construct their internal Stage 1/2/3/4 Meta
# objects without needing this target's real per-stage ECF files to
# exist yet.
#
# The topdir/inputdir/outputdir values below are INERT PLACEHOLDERS:
# they are always overwritten at runtime by the optimizer's
# initialize_meta() before any file I/O happens against them.
#
# To tune settings for your target, edit the per-target ECF cells in
# the notebook (Section 1.1), NOT this file.
# =====================================================================

# Eureka! Control File for Stage 1: Detector Processing

# Stage 1 Documentation: https://eurekadocs.readthedocs.io/en/latest/ecf.html#stage-1

suffix                    uncal
pmap                      1535         # Setting a fixed pmap value to ensure consistency in reductions

maximum_cores             'half'       # Options are 'none', 'quarter', 'half', 'all', or any integer

# Pipeline stages
skip_emicorr              False        #### LOW PRIORITY: If observations use SUB64 or SUB128 subarrays, turning this to True will leave behind EMI artifacts, but may reduce noise in other ways
skip_saturation           False
skip_lastframe            False        #### HIGH PRIORITY: If observations have a small number of groups, turning this to True will increase the number of frames used (reducing photon noise), but at the cost of adding a known-noisy frame
skip_reset                False
skip_linearity            False
skip_rscd                 False        #### MEDIUM PRIORITY: If observations have a small number of groups, turning this to True will increase the number of frames used (reducing photon noise), but at the cost of adding known-noisy frames
skip_dark_current         True         #### LOW PRIORITY: Turning this to False will subtract a dark current reference file, which may reduce noise in some cases but can also add noise if the reference file has artifacts
skip_refpix               False
skip_jump                 False
skip_clean_flicker_noise  True         #### LOW PRIORITY: MIRI has little "flicker" or 1/f noise, so this step is generally not necessary for MIRI data.

#Pipeline stages parameters
jump_rejection_threshold  8.0          #### MEDIUM PRIORITY: Increasing this value will reduce the number of good frames marked as cosmic rays, which will reduce photon noise but may also allow more cosmic rays to remain in the data. Meanwhile, decreasing it will increase photon noise but may also remove more cosmic rays.
rscd_group_skip1          None         #### Number of groups to flag as DO_NOT_USE via the RSCD step in the FIRST integration only. Requires the eureka.optimizer/miri_firstframe RSCD machinery; has no effect on branches without it (e.g. tjb_rwddt).
rscd_group_skip           None         #### Number of groups to flag as DO_NOT_USE via the RSCD step in all LATER integrations. Same branch requirement as rscd_group_skip1.

# Diagnostics
isplots_S1                3
nplots                    5
hide_plots                True
verbose                   False

# Project directory (placeholder - overwritten at runtime by initialize_meta)
topdir                    /tmp

# Directories relative to topdir (placeholders - overwritten at runtime)
inputdir                  Uncalibrated
outputdir                 Stage1opt
